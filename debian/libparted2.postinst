#!/bin/sh

set -e

# begin-remove-after: released:trixie
if test "$1" = configure; then
	for f in libparted.so.2 libparted.so.2.0.5; do
		dpkg-divert --no-rename --package libparted2 --divert "/lib/#DEB_HOST_MULTIARCH#/$f.usr-is-merged" --remove "/lib/#DEB_HOST_MULTIARCH#/$f"
	done
fi
# end-remove-after

#DEBHELPER#
