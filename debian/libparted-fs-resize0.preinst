#!/bin/sh

set -e

# begin-remove-after: released:trixie
if test "$1" = upgrade || test "$1" = install; then
	for f in libparted-fs-resize.so.0 libparted-fs-resize.so.0.0.5; do
		dpkg-divert --no-rename --package libparted-fs-resize0 --divert "/lib/#DEB_HOST_MULTIARCH#/$f.usr-is-merged" --add "/lib/#DEB_HOST_MULTIARCH#/$f"
	done
fi
# end-remove-after

#DEBHELPER#
